 // ---------- Streaming ----------
+// Envia o mp4 fragmentado do ffmpeg. O "close" precisa ser observado ANTES do await:
+// se o cliente sai enquanto o ffprobe roda (seek/troca de aula), o evento já passou e
+// um ffmpeg criado depois ficaria preso para sempre escrevendo num socket morto.
+async function sendRemux(res: import("express").Response, file: string, startSec: number, transcode: boolean) {
+  let ff: ReturnType<typeof remuxStream> | null = null;
+  let gone = false;
+  res.on("close", () => {
+    gone = true;
+    try {
+      ff?.kill("SIGKILL");
+    } catch {}
+  });
+  const codecs = await probeCodecs(file);
+  if (gone) return;
+  res.setHeader("Content-Type", "video/mp4");
+  ff = remuxStream(file, startSec, transcode, codecs);
+  ff.on("error", () => res.destroy());
+  ff.stdout.pipe(res);
+}
+
